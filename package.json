{
  "name": "document-labeler-modules-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lit.js modules UI for document-labeler API",
  "main": "./dist/digitizer-modules.iife.js",
  "module": "./dist/digitizer-modules.js",
  "browser": "./dist/digitizer-modules.js",
  "exports": {
    ".": {
      "import": "./dist/digitizer-modules.js",
      "default": "./dist/digitizer-modules.iife.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf .build dist && tsc -p tsconfig.build.json && rollup -c",
    "preview": "serve dist -l 4173",
    "test": "npm run build && playwright test",
    "test:e2e": "npm test"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@playwright/test": "^1.65.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.68.8",
    "rollup-plugin-copy": "^3.5.0",
    "serve": "^14.2.8",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
